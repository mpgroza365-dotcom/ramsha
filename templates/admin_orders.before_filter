<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة الطلبات - رمشة</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f6f8;
            color: #222;
        }

        .header {
            background: #ff7a00;
            color: white;
            padding: 18px;
            text-align: center;
            font-size: 22px;
            font-weight: bold;
        }

        .container {
            max-width: 1000px;
            margin: 20px auto;
            padding: 0 15px;
        }

        .order {
            background: white;
            border-radius: 16px;
            padding: 18px;
            margin-bottom: 18px;
            box-shadow: 0 3px 12px rgba(0,0,0,.08);
        }

        .order-head {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 15px;
        }

        .order-id {
            font-size: 20px;
            font-weight: bold;
            color: #ff7a00;
        }

        .status {
            background: #fff3e8;
            color: #ff7a00;
            padding: 7px 12px;
            border-radius: 20px;
            font-size: 14px;
        }

        .info {
            line-height: 1.9;
            margin-bottom: 15px;
        }

        .items {
            border-top: 1px solid #eee;
            padding-top: 12px;
        }

        .item {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #f1f1f1;
        }

        .total {
            margin-top: 15px;
            font-size: 19px;
            font-weight: bold;
            color: #111;
        }

        .empty {
            background: white;
            border-radius: 16px;
            padding: 40px 20px;
            text-align: center;
            color: #777;
        }

        @media (max-width: 600px) {
            .item {
                gap: 10px;
            }
        }
    </style>
</head>

<body>

<div class="header">
    🛍️ إدارة طلبات رمشة

    <div style="margin-top:12px;">
        <a href="/admin/logout"
           style="
           display:inline-block;
           background:white;
           color:#ff7a00;
           text-decoration:none;
           padding:8px 18px;
           border-radius:10px;
           font-size:14px;
           font-weight:bold;
           ">
            🔒 تسجيل الخروج
        </a>
    </div>
</div>

<div class="container">

    {% if orders %}

        {% for order in orders %}

        <div class="order">

            <div class="order-head">
                <div class="order-id">
                    الطلب #{{ order.id }}
                </div>

                <div class="status">
                    {{ order.status }}
                </div>
            </div>

            <div class="info">
                👤 <strong>الاسم:</strong> {{ order.customer_name }}<br>
                📞 <strong>الهاتف:</strong> {{ order.phone }}<br>
                📍 <strong>العنوان:</strong> {{ order.address }}<br>

                {% if order.notes %}
                    📝 <strong>ملاحظات:</strong> {{ order.notes }}<br>
                {% endif %}

                💳 <strong>الدفع:</strong>
                {% if order.payment_method == "shamcash" %}
                    شام كاش
                {% else %}
                    الدفع عند الاستلام
                {% endif %}

                {% if order.transaction_number %}
                    <br>
                    🔢 <strong>رقم العملية:</strong>
                    {{ order.transaction_number }}
                {% endif %}

                <br>
                🕐 <strong>التاريخ:</strong> {{ order.created_at }}
            </div>

            <div class="items">

                {% for item in order['items'] %}

                <div class="item">
                    <span>
                        {{ item.product_name }}
                        × {{ item.quantity }}
                    </span>

                    <strong>
                        {{ item.item_total }}
                    </strong>
                </div>

                {% endfor %}

            </div>

            <div class="total">
                الإجمالي: {{ order.grand_total }}
            </div>

            <div style="margin-top:18px; padding-top:15px; border-top:1px solid #eee;">
                <div style="font-weight:bold; margin-bottom:10px;">
                    تغيير حالة الطلب:
                </div>

                <form method="POST"
                      action="/admin/orders/{{ order.id }}/status"
                      style="display:flex; gap:8px; flex-wrap:wrap;">

                    <button name="status"
                            value="جديد"
                            type="submit"
                            style="border:0; border-radius:10px; padding:10px 14px; background:#fff3e8; color:#ff7a00;">
                        🟠 جديد
                    </button>

                    <button name="status"
                            value="قيد التجهيز"
                            type="submit"
                            style="border:0; border-radius:10px; padding:10px 14px; background:#eaf3ff; color:#1976d2;">
                        🔵 قيد التجهيز
                    </button>

                    <button name="status"
                            value="تم التوصيل"
                            type="submit"
                            style="border:0; border-radius:10px; padding:10px 14px; background:#eaf8ef; color:#218838;">
                        🟢 تم التوصيل
                    </button>

                    <button name="status"
                            value="ملغي"
                            type="submit"
                            style="border:0; border-radius:10px; padding:10px 14px; background:#ffecec; color:#d32f2f;">
                        🔴 ملغي
                    </button>

                </form>
            </div>

        </div>

        {% endfor %}

    {% else %}

        <div class="empty">
            لا توجد طلبات حتى الآن
        </div>

    {% endif %}

</div>

</body>
</html>
